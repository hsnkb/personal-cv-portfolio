# ============================================================
# Standart cPanel / Plesk / Apache Hosting Yapılandırması
# ============================================================

RewriteEngine On
RewriteBase /

# 0. Bakım Modu (Deploy esnasında app_offline.htm varsa doğrudan onu göster)
RewriteCond %{REQUEST_URI} !^/app_offline\.htm$
RewriteCond %{DOCUMENT_ROOT}/app_offline.htm -f
RewriteRule ^(.*)$ /app_offline.htm [L]

# 1. Güvenlik: Veri dosyasına (data/cv-data.json) doğrudan tarayıcıdan erişimi engelle
RewriteRule ^data/ - [F,L]

# 2. API İsteklerini PHP Motoruna Yönlendir
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# 3. Sayfa Rotaları
RewriteRule ^$ public/index.html [L]
RewriteRule ^admin/?$ public/admin.html [L]
RewriteRule ^print-cv/?$ public/print-cv.html [L]

# 4. Statik Dosyaları (CSS, JS, Resimler, Uploads) public klasöründen yönlendir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# Güvenlik başlıkları (Opsiyonel)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
